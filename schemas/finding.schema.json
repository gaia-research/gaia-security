{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaia-research/gaia-security/schemas/finding.schema.json",
  "title": "Normalized finding",
  "type": "object",
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^GSEC-[0-9a-f]{12}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "category": {
      "enum": [
        "sast",
        "dependency",
        "secret",
        "misconfig",
        "ci-workflow",
        "skill-safety"
      ]
    },
    "title": {
      "type": "string"
    },
    "raw_severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "primary_file": {
      "type": "string"
    },
    "primary_line": {
      "type": "integer",
      "minimum": 0
    },
    "evidences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scanner": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "raw_severity": {
            "type": "string"
          },
          "file_path": {
            "type": "string"
          },
          "line_start": {
            "type": [
              "integer",
              "null"
            ]
          },
          "line_end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "snippet_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "advisory_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "package_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "package_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "ecosystem": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "scanner",
          "rule_id",
          "raw_severity",
          "file_path",
          "line_start",
          "line_end",
          "message",
          "snippet_sha256",
          "advisory_ids",
          "source_url",
          "package_name",
          "package_version",
          "ecosystem"
        ],
        "additionalProperties": false
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "is_genuine": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_reachable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "boundary_crossed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exploitation_plausible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "existing_mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "enum": [
            "pending_validation",
            "action_required",
            "remediated_in_pr",
            "false_positive",
            "accepted_risk",
            "test_fixture_excluded",
            "deferred_steward_wave"
          ]
        },
        "validated_priority": {
          "enum": [
            "UNASSESSED",
            "P0",
            "P1",
            "P2",
            "P3",
            "P4",
            "NONE"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "disposition_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "is_genuine",
        "is_reachable",
        "boundary_crossed",
        "exploitation_plausible",
        "existing_mitigations",
        "duplicate_of",
        "disposition",
        "validated_priority",
        "confidence",
        "rationale",
        "disposition_id"
      ],
      "additionalProperties": false
    },
    "remediation": {
      "type": "object",
      "properties": {
        "recommended_action": {
          "type": "string"
        },
        "authorization_status": {
          "const": "requires_human_or_lead_approval"
        },
        "regression_test_requirement": {
          "type": "string"
        },
        "verification_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_instances_query": {
          "type": "string"
        },
        "batch_group_key": {
          "type": "string"
        }
      },
      "required": [
        "recommended_action",
        "authorization_status",
        "regression_test_requirement",
        "verification_steps",
        "related_instances_query",
        "batch_group_key"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "finding_id",
    "repository",
    "category",
    "title",
    "raw_severity",
    "primary_file",
    "primary_line",
    "evidences",
    "validation",
    "remediation"
  ],
  "additionalProperties": false
}
