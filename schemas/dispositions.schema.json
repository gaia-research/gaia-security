{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaia-research/gaia-security/schemas/dispositions.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "dispositions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "notes": {
      "type": "string"
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "finding_id",
          "source_commit",
          "expires_at",
          "reviewer",
          "disposition_id",
          "evidence_refs",
          "evidence_sha256",
          "validation"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "finding_id": {
            "type": "string",
            "pattern": "^GSEC-[0-9a-f]{12}$"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "expires_at": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "disposition_id": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "validation": {
            "type": "object",
            "properties": {
              "is_genuine": {
                "type": "boolean"
              },
              "is_reachable": {
                "type": "boolean"
              },
              "boundary_crossed": {
                "type": "boolean"
              },
              "exploitation_plausible": {
                "type": "boolean"
              },
              "existing_mitigations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "duplicate_of": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "disposition": {
                "enum": [
                  "action_required",
                  "remediated_in_pr",
                  "false_positive",
                  "accepted_risk",
                  "test_fixture_excluded",
                  "deferred_steward_wave"
                ]
              },
              "validated_priority": {
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  "P4",
                  "NONE"
                ]
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "rationale": {
                "type": "string"
              },
              "disposition_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "is_genuine",
              "is_reachable",
              "boundary_crossed",
              "exploitation_plausible",
              "existing_mitigations",
              "duplicate_of",
              "disposition",
              "validated_priority",
              "confidence",
              "rationale"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  }
}
